# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL (for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Firebase Admin SDK
FIREBASE_PROJECT_ID=farewise-zimbabwe
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@farewise-zimbabwe.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://farewise-zimbabwe-default-rtdb.firebaseio.com

# Africa's Talking (SMS/OTP)
AFRICA_TALKING_API_KEY=your_africas_talking_api_key
AFRICA_TALKING_USERNAME=your_username
AFRICA_TALKING_SENDER_ID=FareWise

# Paynow Zimbabwe (Payments)
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_RESULT_URL=https://api.farewise.co.zw/api/v1/payments/paynow/result
PAYNOW_RETURN_URL=https://api.farewise.co.zw/api/v1/payments/paynow/return

# Twilio WhatsApp Business API (optional fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=af-south-1
AWS_S3_BUCKET=farewise-uploads

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Ride Matching
MATCHING_RADIUS_KM=5
MATCHING_TIMEOUT_SECONDS=60
DRIVER_ACCEPT_TIMEOUT_SECONDS=30

# Subscription Pricing (USD)
SUBSCRIPTION_STANDARD_USD=20
SUBSCRIPTION_PREMIUM_USD=35
ONBOARDING_FEE_USD=5
